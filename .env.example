# ── ServiceTitan (Developer Portal → My Apps) ──────────────────────
ST_CLIENT_ID=
ST_CLIENT_SECRET=
ST_APP_KEY=
ST_TENANT_ID=
ST_ENV=production            # production | integration

# ── Board access ───────────────────────────────────────────────────
# Long random string. Board is served at /board?k=<BOARD_TOKEN>
BOARD_TOKEN=

# ── Runtime ────────────────────────────────────────────────────────
TZ=America/New_York          # REQUIRED. Without this "today" rolls at 8pm.
PORT=3000
POLL_TODAY_MS=60000          # today's numbers
POLL_REFS_MS=3600000         # business units / job types / employees
POLL_WEEK_MS=3600000         # 7-day trend

# ── Business rules ─────────────────────────────────────────────────
# BOOKING_TARGET_PCT and ESTIMATE_SHARE_CAP_PCT were REMOVED 2026-07-29.
# This is an intake-first business: calls gather what an estimate needs, and
# the booking often lands days later. There is no per-call conversion target
# and no cap on estimates. See CLAUDE.md § What replaced booking rate.
AVG_TICKET_USD=520

# Office hours. Calls outside them are counted but never scored — 97% of
# out-of-hours calls go unanswered because nobody is there, and including
# them reported 53% abandonment against a real in-hours 35%.
BUSINESS_OPEN_HOUR=8
BUSINESS_CLOSE_HOUR=16
BUSINESS_DAYS=Mon,Tue,Wed,Thu,Fri

# Days a missed caller gets to come back through the Nonstop.ai text-back loop
# before counting as unrecovered. Observed median recovery lag is 2.1 days.
RECOVERY_WINDOW_DAYS=7

# Comma-separated ServiceTitan jobTypeId values that are ESTIMATE jobs.
# Run `npm run probe` to list job types with their IDs, then fill this in.
ESTIMATE_JOB_TYPE_IDS=

# Comma-separated employeeId values for CSRs shown on the board.
# Leave blank to auto-include every employee who booked a job or took a lead
# call today — but see CLAUDE.md on automation accounts before you do.
CSR_EMPLOYEE_IDS=

# UNUSED. Kept only so an old .env does not look like it lost a setting.
# Opportunities come from ServiceTitan's own per-call classification
# (Booked / Unbooked), not from call reasons. See CLAUDE.md § Opportunities.
OPPORTUNITY_CALL_REASON_IDS=

# Live CSR phone status is NOT available from ServiceTitan. See CLAUDE.md.
# none | quo   (quo requires QUO_API_KEY and is not implemented yet)
STATUS_SOURCE=none
